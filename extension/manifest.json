{
  "name": "BrainPass",
  "description": "Block distracting websites and boost your productivity with BrainPass.",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "public/popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["public/quiz.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
