# Copy this file to `.env` and fill in your Supabase project values.
# Find them in the Supabase dashboard: Project Settings → API.
#
# The publishable (anon) key is meant to be shipped in clients — your data is
# protected by Row Level Security (see ../supabase/migrations), not by hiding it.
#
# NOTE: this is a Parcel project, so it reads these via process.env at build
# time (not Vite's import.meta.env). The VITE_ prefix is just the variable name.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
